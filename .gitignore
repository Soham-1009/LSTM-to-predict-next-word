# ==============================================================================
# Git Ignore - LSTM Next-Word Prediction & Multi-Domain Generalization Project
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Archive & Compressed Packages (No ZIP / Tar archives in repository)
# ------------------------------------------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.gz
*.bz2
*.xz
*.7z
*.rar
release/*.zip
release/*.tar*
archive/

# ------------------------------------------------------------------------------
# 2. Temporary, Backup, & Log Files
# ------------------------------------------------------------------------------
*.tmp
*.temp
*.bak
*.backup
*.swp
*.swo
*~
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ------------------------------------------------------------------------------
# 3. Python Bytecode, Caches, & Environments
# ------------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
!frontend/lib/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
*.manifest
*.spec

# Virtual Environments
.venv/
backend/.venv/
venv/
ENV/
env/

# Testing & Coverage
.pytest_cache/
**/.pytest_cache/
.coverage
.coverage.*
.tox/
.nox/
coverage.xml
htmlcov/
scratch/
kaggle_*
.ipynb_checkpoints/

# ------------------------------------------------------------------------------
# 4. Model Weights & Large Checkpoints (Track primary inference models via Git LFS)
# ------------------------------------------------------------------------------
*.pt
*.pth
*.bin
*.onnx
*.ckpt
*.safetensors
*.h5

# Keep directory structure via .gitkeep
backend/model/checkpoints/*
!backend/model/checkpoints/.gitkeep
backend/model/weights/*
!backend/model/weights/.gitkeep
backend/model_artifacts/config/*
!backend/model_artifacts/config/.gitkeep

# Checkpoints: allow primary inference models via Git LFS (exclude training continuation latest.pt)
backend/model_artifacts/checkpoints/*
!backend/model_artifacts/checkpoints/.gitkeep
!backend/model_artifacts/checkpoints/best_val.pt
!experiments/multidomain_v1/checkpoints/multidomain_adapted.pt
backend/model_artifacts/checkpoints/latest.pt

# Tokenizer artifacts: preserve vocabulary
backend/model_artifacts/tokenizer/*
!backend/model_artifacts/tokenizer/.gitkeep
!backend/model_artifacts/tokenizer/vocab.json

# ------------------------------------------------------------------------------
# 5. Datasets (Exclude massive 517 MB raw text corpus; track processed train/val/test & offsets)
# ------------------------------------------------------------------------------
dataset/
data/
**/dataset/
**/data/
backend/datasets/raw/*
!backend/datasets/raw/.gitkeep
!backend/datasets/raw/sample_corpus.txt
backend/datasets/raw/wikitext-103.txt
backend/datasets/processed/*
!backend/datasets/processed/.gitkeep
!backend/datasets/processed/metadata.json
!backend/datasets/processed/train.bin
!backend/datasets/processed/val.bin
!backend/datasets/processed/test.bin
!backend/datasets/processed/offsets/
!backend/datasets/processed/offsets/*
!experiments/multidomain_v1/pilot/processed/*

# ------------------------------------------------------------------------------
# 6. Node.js & Next.js Frontend
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
frontend/node_modules/
.next/
**/.next/
frontend/.next/
out/
frontend/out/
frontend/build/
.npm
.eslintcache
*.tsbuildinfo
.vercel/

# ------------------------------------------------------------------------------
# 7. Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# ------------------------------------------------------------------------------
# 8. Operating System & IDE Artifacts
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# Agent / Tooling local metadata
.agents/
.gemini/

