# Backend environment configuration
# Copy this file to `.env` and adjust values for your local setup.

# --- Model artifacts (paths relative to backend/ if not absolute) ---
MODEL_PATH=model/lstm_model.pth
TOKENIZER_PATH=model/tokenizer.pkl
CONFIG_PATH=model/config.json

# --- Device: "auto", "cpu", or "cuda" ---
DEVICE=auto

# --- CORS: comma-separated list of allowed origins ---
# Includes both the Vite dev server (5173, legacy) and the Next.js dev server (3000).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# --- Request limits ---
MAX_INPUT_CHARS=500
MAX_TOP_K=20
MAX_GENERATE_WORDS=50
